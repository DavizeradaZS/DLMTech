<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity_CadastroFunc"
    android:background="@drawable/degrade"
    android:fontFamily="@font/roboto_condensed_regular"
    >

  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/constraintLayout"
      android:layout_width="0dp"
      android:layout_height="65dp"
      app:layout_constraintBottom_toTopOf="@+id/linearLayout2"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="131dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/logo_description"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_launcher_foreground" />

    <EditText
        android:id="@+id/editTextText2"
        android:layout_width="237dp"
        android:layout_height="47dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/bordaredonda"
        android:ems="10"
        android:hint="Pesquisa"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView"
        app:layout_constraintTop_toTopOf="parent" />
  </androidx.constraintlayout.widget.ConstraintLayout>

  <View
      android:id="@+id/view5"
      android:layout_width="match_parent"
      android:layout_height="3dp"
      android:layout_marginTop="64dp"
      android:background="#CC0000"
      app:layout_constraintBottom_toBottomOf="@+id/constraintLayout3"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.0"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="@+id/constraintLayout"
      app:layout_constraintVertical_bias="0.002" />



  <View
      android:id="@+id/view4"
      android:layout_width="match_parent"
      android:layout_height="3dp"
      android:background="#CC0000"
      app:layout_constraintBottom_toBottomOf="@+id/constraintLayout3"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.0"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.895" />


  <androidx.core.widget.NestedScrollView
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:fillViewport="true"
      app:layout_constraintTop_toBottomOf="@+id/constraintLayout"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

      <TextView
          android:id="@+id/txtTitulo"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="CADASTRO DE FUNCIONÁRIO"
          android:textColor="#FF0000"
          android:textSize="22sp"
          android:textStyle="bold"
          android:layout_marginTop="16dp"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent" />

      <TextView
          android:id="@+id/txtInfoPessoais"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Informações Pessoais"
          android:textColor="#FF0000"
          android:textSize="18sp"
          android:textStyle="bold"
          android:layout_marginTop="24dp"
          app:layout_constraintTop_toBottomOf="@+id/txtTitulo"
          app:layout_constraintStart_toStartOf="parent" />

      <TextView
          android:id="@+id/lblNome"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Nome Cliente:"
          android:textColor="#FFFFFF"
          android:layout_marginTop="16dp"
          app:layout_constraintTop_toBottomOf="@+id/txtInfoPessoais"
          app:layout_constraintStart_toStartOf="parent" />

      <EditText
          android:id="@+id/edtNome"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:background="@drawable/bordaredonda" android:layout_marginTop="8dp"
          app:layout_constraintTop_toBottomOf="@+id/lblNome"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent" />

      <TextView
          android:id="@+id/lblDataNasc"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Data Nascimento:"
          android:textColor="#FFFFFF"
          android:layout_marginTop="16dp"
          app:layout_constraintTop_toBottomOf="@+id/edtNome"
          app:layout_constraintStart_toStartOf="parent" />

      <EditText
          android:id="@+id/edtDataNasc"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_marginTop="8dp"
          android:layout_marginEnd="8dp"
          android:background="@drawable/bordaredonda"
          app:layout_constraintTop_toBottomOf="@+id/lblDataNasc"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toStartOf="@+id/edtCPF" />


      <TextView
        android:id="@+id/lblCPF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CPF:"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="@+id/lblDataNasc"
        app:layout_constraintStart_toStartOf="@+id/edtCPF" />

      <EditText
          android:id="@+id/edtCPF"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/bordaredonda"
          app:layout_constraintTop_toTopOf="@+id/edtDataNasc"
          app:layout_constraintStart_toEndOf="@+id/edtDataNasc"
          app:layout_constraintEnd_toEndOf="parent" />

      <TextView
          android:id="@+id/txtInfoPessoais2"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="264dp"
          android:text="Informações de Funcionário"
          android:textColor="#FF0000"
          android:textSize="18sp"
          android:textStyle="bold"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/txtTitulo" />

      <TextView
          android:id="@+id/lblAdm"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:text="Nível de Acesso:"
          android:textColor="#FFFFFF"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/txtInfoPessoais2" />

      <EditText
          android:id="@+id/edtAdm"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_marginTop="8dp"
          android:background="@drawable/bordaredonda"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/lblAdm" />

      <TextView
          android:id="@+id/lblDataAdm"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="64dp"
          android:text="Data de Admissão:"
          android:textColor="#FFFFFF"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="@+id/edtAdm"
          />

      <TextView
          android:id="@+id/lblSal"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Data de Admissão:"
          android:textColor="#FFFFFF"

          app:layout_constraintStart_toStartOf="@+id/edtSal"
          app:layout_constraintTop_toTopOf="@+id/lblDataAdm" />

      <EditText
          android:id="@+id/edtSal"
          android:layout_width="0dp"
          android:layout_height="48dp"

          android:layout_marginStart="8dp"
          android:background="@drawable/bordaredonda"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toEndOf="@+id/edtDataAdm"
          app:layout_constraintTop_toTopOf="@+id/edtDataAdm" />

      <EditText
          android:id="@+id/edtDataAdm"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_marginTop="8dp"
          android:layout_marginEnd="8dp"
          android:background="@drawable/bordaredonda"
          app:layout_constraintEnd_toStartOf="@+id/edtSal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/lblDataAdm" />

      <TextView
          android:id="@+id/txtInfoPessoais3"
          android:layout_width="213dp"
          android:layout_height="27dp"
          android:layout_marginTop="496dp"
          android:text="Informações de Endereço"
          android:textColor="#FF0000"
          android:textSize="18sp"
          android:textStyle="bold"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/txtTitulo" />

      <EditText
          android:id="@+id/edtCep"
          android:layout_width="163dp"
          android:layout_height="48dp"
          android:layout_marginTop="4dp"
          android:background="@drawable/bordaredonda"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="@+id/imageView3" />

      <ImageView
          android:id="@+id/imageView3"
          android:layout_width="41dp"
          android:layout_height="44dp"
          android:layout_marginTop="12dp"
          app:layout_constraintStart_toEndOf="@+id/edtCep"
          app:layout_constraintTop_toBottomOf="@+id/lblCep"
          app:srcCompat="@android:drawable/ic_menu_search" />

      <TextView
          android:id="@+id/lblRua"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="Rua:"
          android:textColor="#FFFFFF"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/edtCep" />

      <EditText
          android:id="@+id/edtRua"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_marginTop="16dp"
          android:background="@drawable/bordaredonda"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintHorizontal_bias="0.0"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/lblRua" />

      <TextView
          android:id="@+id/lblBairro"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Bairro:"
          android:textColor="#FFFFFF"
          app:layout_constraintBottom_toTopOf="@+id/edtBairro"
          app:layout_constraintStart_toStartOf="@+id/edtBairro"
          app:layout_constraintTop_toTopOf="@+id/lblNum"
          app:layout_constraintVertical_bias="0.09" />

      <EditText
          android:id="@+id/edtNum"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_marginTop="20dp"
          android:layout_marginEnd="8dp"
          android:background="@drawable/bordaredonda"
          app:layout_constraintEnd_toStartOf="@+id/edtBairro"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/lblNum" />

      <TextView
          android:id="@+id/lblNum"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          android:text="Número:"
          android:textColor="#FFFFFF"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/edtRua" />

      <EditText
          android:id="@+id/edtBairro"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:background="@drawable/bordaredonda"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toEndOf="@+id/edtNum"
          app:layout_constraintTop_toTopOf="@+id/edtNum" />

      <TextView
          android:id="@+id/lblCep"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"

          android:text="CEP:"
          android:textColor="#FFFFFF"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/txtInfoPessoais3" />
      <Button
          android:id="@+id/btnCancelar"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="56dp"
          android:layout_marginTop="28dp"
          android:backgroundTint="#B22222"
          android:text="Cancelar"
          android:textStyle="bold"
          app:cornerRadius="15px"
          app:layout_constraintBottom_toBottomOf="@+id/btnSalvar"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/edtNum"
          app:layout_constraintVertical_bias="0.0" />

      <Button
          android:id="@+id/btnSalvar"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="28dp"
          android:backgroundTint="#B22222"
          android:text="Salvar"
          android:textStyle="bold"
          app:cornerRadius="15px"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintHorizontal_bias="0.763"
          app:layout_constraintStart_toEndOf="@+id/btnCancelar"
          app:layout_constraintTop_toBottomOf="@+id/edtBairro" />



    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.core.widget.NestedScrollView>

  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/constraintLayout3"
      android:layout_width="match_parent"
      android:layout_height="90dp"
      android:visibility="invisible"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      tools:visibility="invisible">


    <ImageButton
        android:id="@+id/imageButton"
        style="@style/BtnNavegacao"
        android:background="?attr/actionModeCloseDrawable"
        android:rotationY="180"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/imageButton2"
        style="@style/BtnNavegacao"
        android:background="?android:attr/listChoiceIndicatorSingle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imageButton"
        app:layout_constraintStart_toEndOf="@+id/imageButton3"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/imageButton3"
        style="@style/BtnNavegacao"
        android:background="?android:attr/listChoiceIndicatorMultiple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imageButton2"
        app:layout_constraintStart_toEndOf="@+id/imageButton4"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/imageButton4"
        style="@style/BtnNavegacao"
        android:background="?android:attr/listChoiceIndicatorSingle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imageButton3"
        app:layout_constraintStart_toEndOf="@+id/imageButton5"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/imageButton5"
        style="@style/BtnNavegacao"
        android:background="?attr/homeAsUpIndicator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
