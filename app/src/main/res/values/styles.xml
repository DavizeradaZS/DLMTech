<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="EditTextPesquisa" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">210dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">0dp</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:background">@drawable/bordaredonda</item>
        <item name="android:ems">10</item>
        <item name="android:hint">Pesquisa</item>
        <item name="android:inputType">text</item>
        <item name="android:paddingLeft">10dp</item>
    </style>
    <style name="LogoStyle">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:contentDescription">@string/logo_description</item>
        <item name="android:layout_marginLeft">0dp</item>
    </style>
    <style name="BotaoIconeCarrinho">
        <item name="android:layout_width">70dp</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">center</item>
    </style>


    <style name="BtnAcao">
        <item name="backgroundTint">#B22222</item>
        <item name="android:fontFamily">sans-serif-condensed-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">15dp</item>
    </style>
    <style name="CardProduto">
        <item name="android:layout_width">127dp</item>
        <item name="android:layout_height">190dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:layout_marginRight">3dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="cardViewImg">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">120dp</item>
        <item name="android:layout_marginLeft">7dp</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:layout_marginRight">7dp</item>
        <item name="android:padding">15dp</item>
    </style>
    <style name="CardImg">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">120dp</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:src">@drawable/dlmtech1</item>
    </style>
    <style name="CardTxt">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:gravity">center</item>
        <item name="android:text">Carregando Produto...</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BtnNavegacao">
        <item name="android:layout_width">82dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">center</item>
    </style>
</resources>