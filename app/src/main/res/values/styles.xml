<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="EditTextPesquisa" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginLeft">7dp</item>
        <item name="android:layout_marginRight">7dp</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:background">@drawable/bordaredonda</item>
        <item name="android:ems">10</item>
        <item name="android:hint">@string/hint_search</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:inputType">text</item>
        <item name="android:paddingLeft">10dp</item>
    </style>
    <style name="LogoStyle">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:contentDescription">@string/logo_description</item>
        <item name="android:layout_marginLeft">0dp</item>
    </style>
    <style name="BotaoIconeCarrinho">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginRight">7dp</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background"></item>
        <item name="android:padding">0dp</item>
        <item name="android:src">@drawable/carrinhocarrinho</item>
    </style>


    <style name="BtnAcao">
        <item name="backgroundTint">#B22222</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-condensed-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">15dp</item>
    </style>
    <style name="CardProduto">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">5dp</item>
        <item name="android:layout_marginRight">5dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="cardViewImg">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">120dp</item>
        <item name="android:layout_marginLeft">7dp</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:layout_marginRight">7dp</item>
        <item name="android:padding">15dp</item>
    </style>
    <style name="CardImg">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minHeight">120dp</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:src">@drawable/dlmtech1</item>
    </style>
    <style name="CardTxt">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:gravity">center</item>
        <item name="android:text">@string/msg_loading_product</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ImgBtnNavegacaoAnalise">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:background"></item>
        <item name="android:padding">7dp</item>
        <item name="android:src">@drawable/analisededados</item>
    </style>
    <style name="ImgBtnNavegacaoEstoque">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:background"></item>
        <item name="android:padding">7dp</item>
        <item name="android:src">@drawable/carrinhodemao</item>
    </style>
    <style name="ImgBtnNavegacaoHome">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:background"></item>
        <item name="android:padding">0dp</item>
        <item name="android:src">@drawable/botaodeinicio</item>
    </style>

    <style name="ImgBtnNavegacaoClientes">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:background"></item>
        <item name="android:padding">5dp</item>
        <item name="android:src">@drawable/pessoas</item>
    </style>
    <style name="ImgBtnNavegacaoFuncionarios">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:background"></item>
        <item name="android:padding">5dp</item>
        <item name="android:src">@drawable/informacaopessoal</item>
    </style>
</resources>